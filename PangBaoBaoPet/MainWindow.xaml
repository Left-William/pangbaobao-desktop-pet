<Window x:Class="PangBaoBaoPet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="胖宝宝桌宠" Width="390" Height="490"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" ResizeMode="NoResize">
    <Grid x:Name="Root" Width="390" Height="490">
        <Grid.RowDefinitions>
            <RowDefinition Height="110" />
            <RowDefinition Height="380" />
        </Grid.RowDefinitions>
        <Border x:Name="SpeechBubble" Grid.Row="0" Width="260" MaxHeight="102"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,12,5"
                Background="#FFF9F4E8" BorderBrush="#FF34323A" BorderThickness="2"
                CornerRadius="15" Padding="12,8" Visibility="Collapsed"
                MouseLeftButtonDown="SpeechBubble_MouseLeftButtonDown">
            <TextBlock x:Name="SpeechText" FontFamily="Microsoft YaHei UI" FontSize="15"
                       Foreground="#FF24232A" TextWrapping="Wrap" MaxHeight="80" />
        </Border>
        <Image x:Name="PetImage" Grid.Row="1" Width="330" Height="362"
               Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Bottom"
               RenderOptions.BitmapScalingMode="HighQuality"
               MouseLeftButtonDown="PetImage_MouseLeftButtonDown" />
    </Grid>
</Window>
