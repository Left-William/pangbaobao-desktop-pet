<Window x:Class="PangBaoBaoPet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="胖宝宝桌宠" Width="430" Height="490"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" ResizeMode="NoResize">
    <Grid x:Name="Root" Width="430" Height="490">
        <Image x:Name="PetImage" Width="330" Height="362" Stretch="Uniform"
               HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18"
               RenderOptions.BitmapScalingMode="HighQuality"
               MouseLeftButtonDown="PetImage_MouseLeftButtonDown"
               MouseMove="PetImage_MouseMove" MouseLeftButtonUp="PetImage_MouseLeftButtonUp" />
        <Canvas x:Name="BubbleLayer">
            <Path x:Name="BubbleTail" Fill="#FFF9F4E8" Stroke="#FF34323A" StrokeThickness="2"
                  Visibility="Collapsed" IsHitTestVisible="False" />
            <Border x:Name="SpeechBubble" Width="260" Background="#FFF9F4E8"
                    BorderBrush="#FF34323A" BorderThickness="2" CornerRadius="18"
                    Padding="13,9" Visibility="Collapsed"
                    MouseLeftButtonDown="SpeechBubble_MouseLeftButtonDown">
                <TextBlock x:Name="SpeechText" FontFamily="Microsoft YaHei UI" FontSize="15"
                           Foreground="#FF24232A" TextWrapping="Wrap" />
            </Border>
        </Canvas>
        <Canvas x:Name="EffectsLayer" IsHitTestVisible="False" />
    </Grid>
</Window>
