<Window x:Class="PangBaoBaoPet.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="胖宝宝桌宠设置" Width="640" Height="690" MinWidth="560" MinHeight="620"
        WindowStartupLocation="CenterOwner" FontFamily="Microsoft YaHei UI" FontSize="14">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" FontSize="20" FontWeight="SemiBold" Text="对话与互动" Margin="0,0,0,10" />
        <StackPanel Grid.Row="1">
            <TextBlock x:Name="AffectionStatusText" FontWeight="SemiBold" Margin="0,0,0,8" />
            <CheckBox x:Name="BubbleEnabledBox" Content="启用自动气泡" Margin="0,0,0,7" />
            <CheckBox x:Name="AffectionEnabledBox" Content="点击和拖动增加好感度" Margin="0,0,0,4" />
            <TextBlock Text="点头部会冒爱心并播放娇羞动作；关闭计分后仍可摸头。"
                       Foreground="#FF555555" Margin="0,0,0,10" />
            <TextBlock Text="每隔指定秒数判定一次。概率为每次判定的命中率；冷却从气泡消失后开始。"
                       TextWrapping="Wrap" Foreground="#FF555555" Margin="0,0,0,10" />
            <UniformGrid Columns="4" Margin="0,0,0,12">
                <StackPanel Margin="0,0,10,0"><TextBlock Text="判定间隔（秒）"/><TextBox x:Name="IntervalBox"/></StackPanel>
                <StackPanel Margin="0,0,10,0"><TextBlock Text="命中概率（%）"/><TextBox x:Name="ProbabilityBox"/></StackPanel>
                <StackPanel Margin="0,0,10,0"><TextBlock Text="冷却时间（秒）"/><TextBox x:Name="CooldownBox"/></StackPanel>
                <StackPanel><TextBlock Text="显示时间（秒）"/><TextBox x:Name="DurationBox"/></StackPanel>
            </UniformGrid>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="互动后气泡概率（%）" VerticalAlignment="Center" />
                <TextBox x:Name="InteractionProbabilityBox" Width="60" Margin="10,0,0,0" />
                <TextBlock Text="点击或拖动后单独判定，不改变随机气泡概率。" Foreground="#FF555555" VerticalAlignment="Center" Margin="10,0,0,0" />
            </StackPanel>
        </StackPanel>
        <DockPanel Grid.Row="2" Margin="0,0,0,6">
            <TextBlock Text="气泡文案（语境可选：日常、摸头、拖动、飞吻、打滚）" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Content="添加文案" Width="90" HorizontalAlignment="Right" DockPanel.Dock="Right" Click="Add_Click" />
        </DockPanel>
        <DataGrid x:Name="LinesGrid" Grid.Row="3" AutoGenerateColumns="False" CanUserAddRows="False"
                  CanUserDeleteRows="False" SelectionMode="Single" Margin="0,0,0,10">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="启用" Width="55">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridComboBoxColumn x:Name="ContextColumn" Header="语境" Width="90"
                                        SelectedValueBinding="{Binding Context, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        SelectedValuePath="Id" DisplayMemberPath="Label" />
                <DataGridTextColumn Header="内容" Binding="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
        <DockPanel Grid.Row="4">
            <Button Content="删除选中" Width="90" HorizontalAlignment="Left" DockPanel.Dock="Left" Click="Delete_Click" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                <Button Content="取消" Width="86" Margin="0,0,8,0" Click="Cancel_Click" />
                <Button Content="保存并生效" Width="110" Click="Save_Click" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
