<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets/pet.ico</ApplicationIcon>
    <Version>0.5.0-preview.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets/**/*" Exclude="Assets/stretch_v03/**/*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../config/defaults/persona.md" Link="Defaults/persona.md" CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="../PangBaoBaoPet.Core/PangBaoBaoPet.Core.csproj" />
    <ProjectReference Include="../PangBaoBaoPet.Infrastructure/PangBaoBaoPet.Infrastructure.csproj" />
  </ItemGroup>

</Project>
